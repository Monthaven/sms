{
  "name": "monthaven-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run css:build && node --max-old-space-size=4096 node_modules/next/dist/bin/next dev",
    "build": "npm run css:build && npm run prisma:generate && node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "prisma:generate": "prisma generate",
    "start": "next start",
    "css:build": "tailwindcss -c tailwind.config.js -i ./app/globals.css -o ./app/generated.css",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^10.12.16",
    "lucide-react": "^0.290.0",
    "next": "^15.5.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.5.1",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.0.0",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  },
  "overrides": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  }
}
