{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/telemetry/ingestion/[id]",
      "regex": "^/api/telemetry/ingestion/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/telemetry/ingestion/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/chat/[id]",
      "regex": "^/dashboard/chat/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/chat/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/admin",
      "regex": "^/dashboard/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/admin(?:/)?$"
    },
    {
      "page": "/dashboard/admin/agents",
      "regex": "^/dashboard/admin/agents(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/admin/agents(?:/)?$"
    },
    {
      "page": "/dashboard/admin/automations",
      "regex": "^/dashboard/admin/automations(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/admin/automations(?:/)?$"
    },
    {
      "page": "/dashboard/admin/campaigns",
      "regex": "^/dashboard/admin/campaigns(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/admin/campaigns(?:/)?$"
    },
    {
      "page": "/dashboard/admin/integrations",
      "regex": "^/dashboard/admin/integrations(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/admin/integrations(?:/)?$"
    },
    {
      "page": "/dashboard/campaigns",
      "regex": "^/dashboard/campaigns(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/campaigns(?:/)?$"
    },
    {
      "page": "/dashboard/chat",
      "regex": "^/dashboard/chat(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/chat(?:/)?$"
    },
    {
      "page": "/dashboard/inbox",
      "regex": "^/dashboard/inbox(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/inbox(?:/)?$"
    },
    {
      "page": "/dashboard/intelligence",
      "regex": "^/dashboard/intelligence(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/intelligence(?:/)?$"
    },
    {
      "page": "/dashboard/queue",
      "regex": "^/dashboard/queue(?:/)?$",
