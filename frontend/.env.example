# ==============================================================================
# 
# Environment Configuration Template for Monthaven Acquisition Engine (MAE)
# 
# Instructions:
# 1. Copy this file to .env.local for local development
# 2. Never commit real credentials to version control
# 3. Use environment variables in production (Vercel, etc.)
# ==============================================================================

# ==============================================================================
# DATABASE
# ==============================================================================

# PostgreSQL connection string (Neon serverless recommended)
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/sms?sslmode=require"

# ==============================================================================
# TWILIO - Primary SMS Provider (Office line, Voice calls)
# ==============================================================================

# Your Twilio Account SID (starts with AC)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN="your_auth_token_here"

# Twilio phone number for sending (E.164 format)
TWILIO_PHONE_NUMBER="+12223334444"

# TwiML App SID for voice handling
TWILIO_TWIML_APP_SID="APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# API Key for Twilio Voice Client SDK
TWILIO_API_KEY="SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_API_SECRET="your_api_secret_here"

# Optional: Webhook URL for signature validation
TWILIO_WEBHOOK_URL="https://yourdomain.com/api/webhooks/twilio"
VALIDATE_TWILIO_SIGNATURE="false"

# ==============================================================================
# EZTEXTING - Bulk SMS Provider
# ==============================================================================

# EzTexting credentials (Basic auth)
EZTEXTING_USER="your_eztexting_username"
EZTEXTING_PASS="your_eztexting_password"

# Alternative: API key if using bearer token auth
# EZTEXTING_API_KEY="your_api_key_here"

# Default SMS provider: "twilio" or "eztexting"
DEFAULT_SMS_PROVIDER="twilio"

# ==============================================================================
# EMAIL - Transactional Email
# ==============================================================================

# Email provider: "resend" or "sendgrid"
EMAIL_PROVIDER="resend"

# Resend API Key (if using Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SendGrid API Key (if using SendGrid)
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# From email address
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="MAE System"

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================

# Session secret for cookie signing (generate with: openssl rand -hex 32)
SESSION_SECRET="your_secure_random_secret_here"

# CRON job authorization token
CRON_SECRET="your_cron_secret_here"

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Inbound campaign ID for auto-creating leads from inbound messages
INBOUND_CAMPAIGN_ID="your_campaign_uuid_here"

# Next.js URL (for redirects, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# Enable strict mode for Twilio signature validation
VALIDATE_TWILIO_SIGNATURE="false"

# Log level: trace, debug, info, warn, error
LOG_LEVEL="info"

# ==============================================================================
# DEVELOPMENT ONLY
# ==============================================================================

# Skip authentication in development (NEVER enable in production)
# BYPASS_AUTH="false"

# Enable debug logging
# DEBUG="true"

# ==============================================================================
# VERCEL (Production)
# ==============================================================================

# These are set automatically by Vercel:
# VERCEL_URL
# VERCEL_ENV
