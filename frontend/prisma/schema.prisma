generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AgentStatusLog {
  id        String      @id
  userId    String
  status    AgentStatus
  reason    String?
  createdAt DateTime    @default(now())
  User      User        @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model AssignmentRule {
  id         String   @id
  name       String
  priority   Int      @default(0)
  conditions Json
  assignTo   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([isActive])
  @@index([priority])
}

model AuditLog {
  id         String   @id
  userId     String
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

model Call {
  id                String        @id
  leadId            String?
  contactId         String?
  userId            String
  direction         String
  status            String
  duration          Int?
  twilioCallSid     String?       @unique
  recordingUrl      String?
  recordingSid      String?
  disposition       String?
  notes             String?
  startedAt         DateTime      @default(now())
  answeredAt        DateTime?
  endedAt           DateTime?
  aiInterestScore   Int?
  aiSummary         String?
  callerIdUsed      String?
  fromNumber        String?
  holdDuration      Int?
  holdStartedAt     DateTime?
  monitoredBy       String?
  recordingDuration Int?
  toNumber          String?
  transcription     String?
  transferredFrom   String?
  transferredTo     String?
  voicemailUrl      String?
  Contact           Contact?      @relation(fields: [contactId], references: [id])
  Lead              Lead?         @relation(fields: [leadId], references: [id])
  User              User          @relation(fields: [userId], references: [id])
  QualityScore      QualityScore?

  @@index([leadId])
  @@index([status])
  @@index([twilioCallSid])
  @@index([userId, startedAt])
}

model Campaign {
  id               String         @id
  name             String
  ezTextingGroupId String?
  status           String         @default("DRAFT")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  IngestionJob     IngestionJob[]
  Lead             Lead[]
}

model Contact {
  id                                    String             @id
  phoneE164                             String             @unique
  phoneType                             String?
  firstName                             String?
  lastName                              String?
  email                                 String?
  source                                String             @default("DEALMACHINE")
  priority                              String             @default("LOW")
  score                                 Int?
  smsAllowed                            Boolean            @default(false)
  callOnly                              Boolean            @default(false)
  doNotContact                          Boolean            @default(false)
  ownerMatch                            Boolean            @default(false)
  blockReason                           String?
  createdAt                             DateTime           @default(now())
  updatedAt                             DateTime
  intent                                String?
  intentSource                          String?
  sendCount                             Int?               @default(0)
  receiveCount                          Int?               @default(0)
  lastSentAt                            DateTime?          @db.Timestamp(6)
  lastReceivedAt                        DateTime?          @db.Timestamp(6)
  lastContactedAt                       DateTime?          @db.Timestamp(6)
  flagsRaw                              String?
  blockDate                             DateTime?          @db.Timestamp(6)
  archived                              Boolean?           @default(false)
  sourceFile                            String?
  decision_maker                        Boolean            @default(false)
  dm_score                              Float?
  dm_tier                               String?
  first_name                            String?
  full_name                             String?
  has_title                             Boolean            @default(false)
  is_primary                            Boolean            @default(false)
  last_name                             String?
  owner_match                           Boolean            @default(false)
  phone_1                               String?
  phone_1_type                          String?
  phone_2                               String?
  phone_2_type                          String?
  phone_3                               String?
  phone_3_type                          String?
  propertyId                            String?
  title                                 String?
  ownerNameMatch                        Boolean            @default(false)
  phoneValid                            Boolean            @default(true)
  smsConsent                            Boolean            @default(false)
  callConsent                           Boolean            @default(false)
  callConsentAt                         DateTime?
  callConsentSource                     String?
  doNotContactReason                    String?
  emailBounced                          Boolean            @default(false)
  emailConsent                          Boolean            @default(false)
  emailConsentAt                        DateTime?
  emailConsentSource                    String?
  phoneInvalid                          Boolean            @default(false)
  smsConsentAt                          DateTime?
  smsConsentSource                      String?
  timezone                              String?
  Call                                  Call[]
  Property_Contact_propertyIdToProperty Property?          @relation("Contact_propertyIdToProperty", fields: [propertyId], references: [id])
  Interaction                           Interaction[]
  Lead                                  Lead[]
  Message                               Message[]
  PhoneFlag                             PhoneFlag[]
  Property_Property_ownerIdToContact    Property[]         @relation("Property_ownerIdToContact")
  ScheduledMessage                      ScheduledMessage[]

  @@index([dm_tier])
  @@index([doNotContact])
  @@index([is_primary])
  @@index([phoneE164])
  @@index([priority, score])
  @@index([propertyId])
}

model DncEntry {
  id        String    @id
  phone     String    @unique
  source    DncSource @default(INTERNAL)
  addedAt   DateTime  @default(now())
  addedBy   String?
  expiresAt DateTime?
  notes     String?

  @@index([phone])
  @@index([source])
}

model DncList {
  id        String   @id
  phoneE164 String   @unique
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model EventLog {
  id        String   @id
  userId    String
  eventType String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

model IngestionJob {
  id              String             @id
  fileName        String
  campaignId      String?
  status          IngestionJobStatus @default(PENDING)
  rowsProcessed   Int                @default(0)
  contactsCreated Int                @default(0)
  leadsCreated    Int                @default(0)
  startedById     String?
  startedAt       DateTime           @default(now())
  finishedAt      DateTime?
  durationSeconds Int?
  errorMessage    String?
  updatedAt       DateTime
  source          String?            @default("file-upload")
  Campaign        Campaign?          @relation(fields: [campaignId], references: [id])
  User            User?              @relation(fields: [startedById], references: [id])
}

model Interaction {
  id         String    @id
  contactId  String
  channel    Channel
  direction  Direction
  body       String
  externalId String?
  createdAt  DateTime  @default(now())
  userId     String?
  Contact    Contact   @relation(fields: [contactId], references: [id])
  User       User?     @relation(fields: [userId], references: [id])

  @@index([contactId])
}

model Lead {
  id                      String             @id
  campaignId              String
  contactId               String
  propertyId              String?
  status                  LeadStatus         @default(NEW)
  sentimentScore          Int                @default(0)
  assignedToId            String?
  isFlagged               Boolean            @default(false)
  notes                   String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime
  assignedAt              DateTime?
  callbackAt              DateTime?
  lockExpiresAt           DateTime?
  Call                    Call[]
  User                    User?              @relation(fields: [assignedToId], references: [id])
  Campaign                Campaign           @relation(fields: [campaignId], references: [id])
  Contact                 Contact            @relation(fields: [contactId], references: [id])
  Property                Property?          @relation(fields: [propertyId], references: [id])
  LeadAudit               LeadAudit[]
  ScheduledMessage        ScheduledMessage[]
  originating_entity      String             @default("monthaven_capital")
  current_entity          String             @default("monthaven_capital")
  handoff_to_brokerage_at DateTime?
  handoff_agreement_id    String?

  @@unique([campaignId, contactId, propertyId])
  @@index([assignedToId])
  @@index([callbackAt])
  @@index([status, assignedToId])
  @@index([status])
}

model LeadAudit {
  id        String   @id
  leadId    String
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  Lead      Lead     @relation(fields: [leadId], references: [id])
  User      User?    @relation(fields: [userId], references: [id])
}

model Message {
  id          String   @id
  phone       String
  direction   String
  body        String
  status      String?
  provider    String
  external_id String?
  campaign_id String?
  contactId   String?
  createdAt   DateTime @default(now())
  intent      String?
  updatedAt   DateTime
  Contact     Contact? @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([direction])
  @@index([phone])
}

model Notification {
  id          String           @id
  userId      String
  type        NotificationType
  priority    Priority         @default(NORMAL)
  title       String
  body        String?
  actionUrl   String?
  actionLabel String?
  relatedType String?
  relatedId   String?
  read        Boolean          @default(false)
  readAt      DateTime?
  dismissed   Boolean          @default(false)
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  User        User             @relation(fields: [userId], references: [id])

  @@index([type, createdAt])
  @@index([userId, read, createdAt])
}

model PhoneFlag {
  id              String    @id
  phone           String    @unique
  dnc             Boolean   @default(false)
  opt_out         Boolean   @default(false)
  bounced         Boolean   @default(false)
  carrier_blocked Boolean   @default(false)
  phone_type      String?
  carrier         String?
  intent          String?
  intent_updated  DateTime?
  source          String?
  contactId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  Contact         Contact?  @relation(fields: [contactId], references: [id])

  @@index([dnc])
  @@index([intent])
  @@index([opt_out])
  @@index([phone])
}

model Portfolio {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String    @unique(map: "idx_portfolio_name")
  property_count     Int?      @default(0)
  primary_contact_id String?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
}

model Property {
  id                                   String    @id
  ownerId                              String?
  addressLine1                         String
  city                                 String?
  state                                String?
  postalCode                           String
  rawDetails                           Json?
  createdAt                            DateTime  @default(now())
  updatedAt                            DateTime
  address                              String?
  mailing_address                      String?
  owner_1_name                         String?
  owner_2_name                         String?
  units                                Int?
  year_built                           Int?
  zip                                  String?
  portfolio_id                         String?
  Contact_Contact_propertyIdToProperty Contact[] @relation("Contact_propertyIdToProperty")
  Lead                                 Lead[]
  Contact_Property_ownerIdToContact    Contact?  @relation("Property_ownerIdToContact", fields: [ownerId], references: [id])

  @@unique([addressLine1, city, state])
}

model QualityScore {
  id             String   @id
  callId         String   @unique
  scoredBy       String
  greeting       Int      @default(0)
  discovery      Int      @default(0)
  objections     Int      @default(0)
  closing        Int      @default(0)
  compliance     Int      @default(0)
  overall        Int      @default(0)
  notes          String?
  coachingPoints String[] @default([])
  scoredAt       DateTime @default(now())
  Call           Call     @relation(fields: [callId], references: [id])
  User           User     @relation(fields: [scoredBy], references: [id])

  @@index([scoredAt])
  @@index([scoredBy])
}

model ScheduledMessage {
  id          String         @id
  contactId   String
  leadId      String?
  userId      String
  body        String
  mediaUrls   String[]       @default([])
  scheduledAt DateTime
  status      ScheduleStatus @default(PENDING)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime       @default(now())
  Contact     Contact        @relation(fields: [contactId], references: [id])
  Lead        Lead?          @relation(fields: [leadId], references: [id])
  User        User           @relation(fields: [userId], references: [id])

  @@index([scheduledAt, status])
  @@index([userId])
}

model Sequence {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String?
  status          String?           @default("draft")
  startDate       DateTime?         @db.Timestamp(6)
  endDate         DateTime?         @db.Timestamp(6)
  totalContacts   Int?              @default(0)
  messagesSent    Int?              @default(0)
  responses       Int?              @default(0)
  hotLeads        Int?              @default(0)
  optOuts         Int?              @default(0)
  createdAt       DateTime?         @default(now()) @db.Timestamp(6)
  updatedAt       DateTime?         @default(now()) @db.Timestamp(6)
  SequenceContact SequenceContact[]
  SequenceStep    SequenceStep[]
}

model SequenceContact {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequence_id  String    @db.Uuid
  contact_id   String
  current_step Int?      @default(0)
  status       String?   @default("active")
  enrolled_at  DateTime? @default(now()) @db.Timestamptz(6)
  last_sent_at DateTime? @db.Timestamptz(6)
  next_send_at DateTime? @db.Timestamptz(6)
  Sequence     Sequence  @relation(fields: [sequence_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sequence_id, contact_id])
}

model SequenceStep {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequenceId      String?   @db.Uuid
  stepNumber      Int
  name            String
  template        String
  delayDays       Int?      @default(0)
  skipIfResponded Boolean?  @default(true)
  skipIfOptedOut  Boolean?  @default(true)
  createdAt       DateTime? @default(now()) @db.Timestamp(6)
  Sequence        Sequence? @relation(fields: [sequenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Settings {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String    @unique
  value      String
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model SmsTemplate {
  id         String   @id
  name       String
  body       String
  category   String?
  variables  String[] @default([])
  isActive   Boolean  @default(true)
  usageCount Int      @default(0)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [createdBy], references: [id])

  @@index([category])
  @@index([isActive])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model User {
  id                 String             @id
  email              String             @unique
  name               String?
  role               UserRole           @default(AGENT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  contractEnvelopeId String?
  contractSignedAt   DateTime?
  sections           String[]           @default([])
  twilioNumber       String?
  settings           Json?
  lastLoginAt        DateTime?
  lockedUntil        DateTime?
  loginAttempts      Int                @default(0)
  passwordHash       String?
  acceptsInbound     Boolean            @default(true)
  forwardNumber      String?
  isOnline           Boolean            @default(false)
  assignedNumbers    String[]           @default([])
  breakReason        String?
  currentCallId      String?
  lastActiveAt       DateTime?
  pushSubscription   Json?
  shiftEnd           DateTime?
  shiftStart         DateTime?
  status             AgentStatus        @default(OFFLINE)
  statusSince        DateTime?
  stackUserId        String?
  AgentStatusLog     AgentStatusLog[]
  AuditLog           AuditLog[]
  Call               Call[]
  IngestionJob       IngestionJob[]
  Interaction        Interaction[]
  Lead               Lead[]
  LeadAudit          LeadAudit[]
  Notification       Notification[]
  QualityScore       QualityScore[]
  ScheduledMessage   ScheduledMessage[]
  SmsTemplate        SmsTemplate[]

  @@index([stackUserId])
}

model WebhookLog {
  id           String    @id
  provider     String
  direction    Direction
  status       String
  statusCode   Int?
  payload      Json?
  errorMessage String?
  createdAt    DateTime  @default(now())
}

model access_grants {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  deal_slug  String?
  scope      String?   @default("teaser")
  granted_at DateTime? @default(now()) @db.Timestamp(6)
  expires_at DateTime? @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model accreditation_records {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @db.Uuid
  kyc_profile_id           String?   @db.Uuid
  accreditation_type       String    @db.VarChar(50)
  verification_method      String?   @db.VarChar(50)
  annual_income            Decimal?  @db.Decimal(15, 2)
  net_worth                Decimal?  @db.Decimal(15, 2)
  liquid_net_worth         Decimal?  @db.Decimal(15, 2)
  professional_designation String?   @db.VarChar(100)
  license_number           String?   @db.VarChar(100)
  entity_qualification     String?   @db.VarChar(100)
  status                   String?   @default("pending") @db.VarChar(20)
  verified_at              DateTime? @db.Timestamptz(6)
  verified_by              String?   @db.VarChar(100)
  verification_provider    String?   @db.VarChar(100)
  verification_reference   String?   @db.VarChar(100)
  effective_date           DateTime? @db.Date
  expiry_date              DateTime? @db.Date
  is_active                Boolean?  @default(true)
  supporting_document_ids  String[]  @db.Uuid
  notes                    String?
  metadata                 Json?     @default("{}")
  created_at               DateTime? @default(now()) @db.Timestamptz(6)
  updated_at               DateTime? @default(now()) @db.Timestamptz(6)

  @@index([is_active], map: "idx_accreditation_active")
  @@index([expiry_date], map: "idx_accreditation_expiry")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accreditation_verifications {
  id                                                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                              String                 @db.Uuid
  status                                               String                 @default("pending") @db.VarChar(50)
  accreditation_type                                   String                 @db.VarChar(50)
  verification_method                                  String?                @db.VarChar(100)
  verified_at                                          DateTime?              @db.Timestamptz(6)
  verified_by                                          String?                @db.Uuid
  income_year                                          Int?
  individual_income                                    Decimal?               @db.Decimal(15, 2)
  joint_income                                         Decimal?               @db.Decimal(15, 2)
  income_documentation_type                            String?                @db.VarChar(100)
  estimated_net_worth                                  Decimal?               @db.Decimal(15, 2)
  net_worth_documentation_type                         String?                @db.VarChar(100)
  license_type                                         String?                @db.VarChar(100)
  license_number                                       String?                @db.VarChar(100)
  license_state                                        String?                @db.VarChar(50)
  license_expiration                                   DateTime?              @db.Date
  entity_name                                          String?                @db.VarChar(255)
  entity_type                                          String?                @db.VarChar(100)
  entity_assets                                        Decimal?               @db.Decimal(15, 2)
  document_ids                                         Json?                  @default("[]")
  expires_at                                           DateTime?              @db.Timestamptz(6)
  renewal_reminder_sent                                Boolean?               @default(false)
  notes                                                String?
  created_at                                           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                                           DateTime               @default(now()) @db.Timestamptz(6)
  users_accreditation_verifications_user_idTousers     users                  @relation("accreditation_verifications_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_accreditation_verifications_verified_byTousers users?                 @relation("accreditation_verifications_verified_byTousers", fields: [verified_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compliance_audit_log                                 compliance_audit_log[]
  compliance_documents                                 compliance_documents[]

  @@index([expires_at], map: "idx_accreditation_expires")
  @@index([status], map: "idx_accreditation_status")
  @@index([user_id], map: "idx_accreditation_user")
}

model ach_transfers {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id             String    @db.Uuid
  transfer_type          String    @db.VarChar(20)
  ach_class              String?   @default("PPD") @db.VarChar(10)
  originator_name        String?   @db.VarChar(255)
  originator_routing     String?   @db.VarChar(50)
  originator_account     String?   @db.VarChar(50)
  receiver_name          String?   @db.VarChar(255)
  receiver_routing       String?   @db.VarChar(50)
  receiver_account_last4 String?   @db.VarChar(4)
  status                 String?   @default("pending") @db.VarChar(50)
  trace_number           String?   @db.VarChar(50)
  batch_number           String?   @db.VarChar(50)
  effective_date         DateTime? @db.Date
  settlement_date        DateTime? @db.Date
  return_code            String?   @db.VarChar(10)
  return_reason          String?
  return_date            DateTime? @db.Date
  noc_code               String?   @db.VarChar(10)
  noc_corrected_data     String?
  processor_response     Json?     @default("{}")
  created_at             DateTime? @default(now()) @db.Timestamptz(6)
  updated_at             DateTime? @default(now()) @db.Timestamptz(6)

  @@index([payment_id], map: "idx_ach_transfers_payment")
  @@index([trace_number], map: "idx_ach_transfers_trace")
}

model activity_comments {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_id             String              @db.Uuid
  user_id                 String              @db.Uuid
  user_name               String?             @db.VarChar(255)
  user_avatar_url         String?
  content                 String
  reply_to_id             String?             @db.Uuid
  is_edited               Boolean?            @default(false)
  edited_at               DateTime?           @db.Timestamptz(6)
  is_deleted              Boolean?            @default(false)
  created_at              DateTime?           @default(now()) @db.Timestamptz(6)
  activity_feeds          activity_feeds      @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  activity_comments       activity_comments?  @relation("activity_commentsToactivity_comments", fields: [reply_to_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_activity_comments activity_comments[] @relation("activity_commentsToactivity_comments")

  @@index([activity_id, created_at], map: "idx_activity_comments_activity")
}

model activity_feeds {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id           String               @db.Uuid
  actor_type         String               @default("user") @db.VarChar(50)
  actor_name         String?              @db.VarChar(255)
  actor_avatar_url   String?
  action             String               @db.VarChar(100)
  target_type        String?              @db.VarChar(100)
  target_id          String?              @db.Uuid
  target_name        String?              @db.VarChar(500)
  target_url         String?
  title              String
  description        String?
  icon               String?              @db.VarChar(50)
  content            Json?                @default("{}")
  visibility         String?              @default("private") @db.VarChar(50)
  visible_to         Json?                @default("[]")
  deal_id            String?              @db.Uuid
  organization_id    String?              @db.Uuid
  importance         String?              @default("normal") @db.VarChar(20)
  is_pinned          Boolean?             @default(false)
  reaction_count     Int?                 @default(0)
  comment_count      Int?                 @default(0)
  metadata           Json?                @default("{}")
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  activity_comments  activity_comments[]
  deals              deals?               @relation(fields: [deal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activity_reactions activity_reactions[]

  @@index([actor_id, created_at(sort: Desc)], map: "idx_activity_actor")
  @@index([created_at(sort: Desc)], map: "idx_activity_created")
  @@index([target_type, target_id], map: "idx_activity_target")
  @@index([visibility], map: "idx_activity_visibility")
