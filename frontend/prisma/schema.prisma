model engagement_events {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  event_type String?
  deal_slug  String?
  metadata   Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model ndas {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  envelope_id String?   @unique
  status      String?   @default("pending")
  signed_at   DateTime? @db.Timestamp(6)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model om_assumptions {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id  String  @unique
  deal_id    String  @db.Uuid
  assumption String?
  sort_order Float?  @db.Real
  deals      deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_assumptions_deal_idx")
}

model om_employment_anchors {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id       String  @unique
  deal_id         String  @db.Uuid
  employer_name   String?
  sector          String?
  employees_count Float?  @db.Real
  distance_miles  Float?  @db.Real
  commute_minutes Float?  @db.Real
  stability_note  String?
  sort_order      Float?  @db.Real
  deals           deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_employment_anchors_deal_idx")
}

model om_gallery_images {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id     String    @unique
  deal_id       String    @db.Uuid
  image_name    String?
  image_url     String?
  category      String?
  alt_text      String?
  source_url    String?
  width         Float?    @db.Real
  height        Float?    @db.Real
  file_size     Float?    @db.Real
  quality_score Float?    @db.Real
  status        String?
  sort_order    Float?    @db.Real
  scraped_at    DateTime? @db.Date
  deals         deals     @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([category])
  @@index([deal_id], map: "om_gallery_images_deal_idx")
}

model om_investment_highlights {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id  String  @unique
  deal_id    String  @db.Uuid
  highlight  String?
  sort_order Float?  @db.Real
  deals      deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_investment_highlights_deal_idx")
}

model om_observations {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id        String  @unique
  deal_id          String  @db.Uuid
  observation_text String?
  sort_order       Float?  @db.Real
  deals            deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_observations_deal_idx")
}

model om_opex_analysis {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id           String  @unique
  deal_id             String  @db.Uuid
  category            String?
  current_value       Float?  @db.Real
  market_benchmark    String?
  savings_opportunity String?
  sort_order          Float?  @db.Real
  current             Float?
  deals               deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_opex_analysis_deal_idx")
}

model om_points_of_interest {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id          String  @unique
  deal_id            String  @db.Uuid
  poi_name           String?
  category           String?
  distance_miles     Float?  @db.Real
  drive_time_minutes Float?  @db.Real
  description        String?
  importance         String?
  sort_order         Float?  @db.Real
  deals              deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_points_of_interest_deal_idx")
}

model om_pricing_guidance {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id  String  @unique
  deal_id    String  @db.Uuid
  label      String?
  price      String?
  sub_line_1 String?
  sub_line_2 String?
  variant    String?
  sort_order Float?  @db.Real
  deals      deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_pricing_guidance_deal_idx")
}

model om_pro_forma {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id  String  @unique
  deal_id    String  @db.Uuid
  period     String?
  egi        Float?  @db.Real
  opex       Float?  @db.Real
  noi        Float?  @db.Real
  growth     String?
  sort_order Float?  @db.Real
  deals      deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_pro_forma_deal_idx")
}

model om_recommendation_items {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id  String  @unique
  deal_id    String  @db.Uuid
  item       String?
  type       String?
  sort_order Float?  @db.Real
  deals      deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_recommendation_items_deal_idx")
}

model om_rent_comps {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id           String   @unique
  deal_id             String   @db.Uuid
  property_name       String?
  year_built          Float?   @db.Real
  occupancy           Float?   @db.Real
  one_br_avg          Float?   @db.Real
  two_br_avg          Float?   @db.Real
  renovation_status   String?
  is_subject_property Boolean? @default(false)
  is_average_row      Boolean? @default(false)
  sort_order          Float?   @db.Real
  deals               deals    @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_rent_comps_deal_idx")
}

model om_returns_summary {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id  String  @unique
  deal_id    String  @db.Uuid
  label      String?
  value      String?
  sort_order Float?  @db.Real
  deals      deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_returns_summary_deal_idx")
}

model om_risks {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id   String  @unique
  deal_id     String  @db.Uuid
  risk_factor String?
  likelihood  String?
  impact      String?
  mitigation  String?
  residual    String?
  sort_order  Float?  @db.Real
  deals       deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_risks_deal_idx")
}

model om_sales_comps {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id           String   @unique
  deal_id             String   @db.Uuid
  property_name       String?
  location            String?
  units               Float?   @db.Real
  year_built          Float?   @db.Real
  price_per_unit      Float?   @db.Real
  cap_rate            Float?   @db.Real
  is_subject_property Boolean? @default(false)
  is_average_row      Boolean? @default(false)
  sort_order          Float?   @db.Real
  deals               deals    @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_sales_comps_deal_idx")
}

model om_sensitivity_matrix {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id  String   @unique
  deal_id    String   @db.Uuid
  row_label  String?
  col_1      String?
  col_2      String?
  col_3      String?
  is_header  Boolean? @default(false)
  sort_order Float?   @db.Real
  deals      deals    @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_sensitivity_matrix_deal_idx")
}

model om_strategic_rationale {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id  String  @unique
  deal_id    String  @db.Uuid
  point      String?
  sort_order Float?  @db.Real
  deals      deals   @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deal_id], map: "om_strategic_rationale_deal_idx")
