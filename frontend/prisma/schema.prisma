generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  role          UserRole       @default(AGENT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ingestionJobs IngestionJob[] @relation("IngestionStartedBy")
  assignedLeads Lead[]
  auditLogs     LeadAudit[]
}

model Contact {
  id                                    String        @id @default(cuid())
  phoneE164                             String        @unique
  phoneType                             String?
  firstName                             String?
  lastName                              String?
  email                                 String?
  source                                String        @default("DEALMACHINE")
  priority                              String        @default("LOW")
  score                                 Int?
  smsAllowed                            Boolean       @default(false)
  callOnly                              Boolean       @default(false)
  doNotContact                          Boolean       @default(false)
  ownerMatch                            Boolean       @default(false)
  blockReason                           String?
  createdAt                             DateTime      @default(now())
  updatedAt                             DateTime      @updatedAt
  intent                                String?
  intentSource                          String?
  sendCount                             Int?          @default(0)
  receiveCount                          Int?          @default(0)
  lastSentAt                            DateTime?     @db.Timestamp(6)
  lastReceivedAt                        DateTime?     @db.Timestamp(6)
  lastContactedAt                       DateTime?     @db.Timestamp(6)
  flagsRaw                              String?
  blockDate                             DateTime?     @db.Timestamp(6)
  archived                              Boolean?      @default(false)
  sourceFile                            String?
  decision_maker                        Boolean       @default(false)
  dm_score                              Float?
  dm_tier                               String?
  first_name                            String?
  full_name                             String?
  has_title                             Boolean       @default(false)
  is_primary                            Boolean       @default(false)
  last_name                             String?
  owner_match                           Boolean       @default(false)
  phone_1                               String?
  phone_1_type                          String?
  phone_2                               String?
  phone_2_type                          String?
  phone_3                               String?
  phone_3_type                          String?
  propertyId                            String?
  title                                 String?
  Property_Contact_propertyIdToProperty Property?     @relation("Contact_propertyIdToProperty", fields: [propertyId], references: [id])
  interactions                          Interaction[]
  leads                                 Lead[]
  Message                               Message[]
  PhoneFlag                             PhoneFlag[]
  properties                            Property[]

  @@index([phoneE164])
  @@index([dm_tier])
  @@index([is_primary])
  @@index([propertyId])
}

model Property {
  id                                   String    @id @default(cuid())
  ownerId                              String?
  addressLine1                         String
  city                                 String?
  state                                String?
  postalCode                           String
  rawDetails                           Json?
  createdAt                            DateTime  @default(now())
  updatedAt                            DateTime  @updatedAt
  address                              String?
  mailing_address                      String?
  owner_1_name                         String?
  owner_2_name                         String?
  units                                Int?
  year_built                           Int?
  zip                                  String?
  portfolio_id                         String?
  Contact_Contact_propertyIdToProperty Contact[] @relation("Contact_propertyIdToProperty")
  leads                                Lead[]
  owner                                Contact?  @relation(fields: [ownerId], references: [id])

  @@unique([addressLine1, city, state])
}

model DncList {
  id        String   @id @default(cuid())
  phoneE164 String   @unique
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Campaign {
  id               String         @id @default(cuid())
  name             String
  ezTextingGroupId String?
  status           String         @default("DRAFT")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  ingestionJobs    IngestionJob[] @relation("CampaignIngestionJobs")
  leads            Lead[]
}

model Lead {
  id             String      @id @default(cuid())
  campaignId     String
  contactId      String
  propertyId     String?
  status         LeadStatus  @default(NEW)
  sentimentScore Int         @default(0)
  assignedToId   String?
  isFlagged      Boolean     @default(false)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  assignedTo     User?       @relation(fields: [assignedToId], references: [id])
  campaign       Campaign    @relation(fields: [campaignId], references: [id])
  contact        Contact     @relation(fields: [contactId], references: [id])
  property       Property?   @relation(fields: [propertyId], references: [id])
  audits         LeadAudit[]

  @@unique([campaignId, contactId, propertyId])
  @@index([status])
  @@index([assignedToId])
}

model LeadAudit {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  lead      Lead     @relation(fields: [leadId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model Interaction {
  id         String    @id @default(cuid())
  contactId  String
  channel    Channel
  direction  Direction
  body       String
  externalId String?
  createdAt  DateTime  @default(now())
  contact    Contact   @relation(fields: [contactId], references: [id])

  @@index([contactId])
}

model IngestionJob {
  id              String             @id @default(cuid())
  fileName        String
  campaignId      String?
  status          IngestionJobStatus @default(PENDING)
  rowsProcessed   Int                @default(0)
  contactsCreated Int                @default(0)
  leadsCreated    Int                @default(0)
  startedById     String?
  startedAt       DateTime           @default(now())
  finishedAt      DateTime?
  durationSeconds Int?
  errorMessage    String?
  updatedAt       DateTime
  campaign        Campaign?          @relation("CampaignIngestionJobs", fields: [campaignId], references: [id])
  startedBy       User?              @relation("IngestionStartedBy", fields: [startedById], references: [id])
}

model WebhookLog {
  id           String    @id @default(cuid())
  provider     String
  direction    Direction
  status       String
  statusCode   Int?
  payload      Json?
  errorMessage String?
  createdAt    DateTime  @default(now())
}

model Sequence {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String?
  status          String?           @default("draft")
  startDate       DateTime?         @db.Timestamp(6)
  endDate         DateTime?         @db.Timestamp(6)
  totalContacts   Int?              @default(0)
  messagesSent    Int?              @default(0)
  responses       Int?              @default(0)
  hotLeads        Int?              @default(0)
  optOuts         Int?              @default(0)
  createdAt       DateTime?         @default(now()) @db.Timestamp(6)
  updatedAt       DateTime?         @default(now()) @updatedAt @db.Timestamp(6)
  SequenceContact SequenceContact[]
  steps           SequenceStep[]
}

model SequenceStep {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequenceId      String?   @db.Uuid
  stepNumber      Int
  name            String
  template        String
  delayDays       Int?      @default(0)
  skipIfResponded Boolean?  @default(true)
  skipIfOptedOut  Boolean?  @default(true)
  createdAt       DateTime? @default(now()) @db.Timestamp(6)
  sequence        Sequence? @relation(fields: [sequenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model SequenceContact {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequence_id  String    @db.Uuid
  contact_id   String
  current_step Int?      @default(0)
  status       String?   @default("active")
  enrolled_at  DateTime? @default(now()) @db.Timestamptz(6)
  last_sent_at DateTime? @db.Timestamptz(6)
  next_send_at DateTime? @db.Timestamptz(6)
  Sequence     Sequence  @relation(fields: [sequence_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sequence_id, contact_id])
}

model access_grants {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  deal_slug  String?
  scope      String?   @default("teaser")
  granted_at DateTime? @default(now()) @db.Timestamp(6)
  expires_at DateTime? @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model audit_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  action      String?
  target_type String?
  target_id   String?
  metadata    Json?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model capital_requests {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  deal_slug  String?
  amount     Float?    @db.Real
  status     String?   @default("pending")
  notes      String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model deals {
  id                          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notion_id                   String                     @unique
  slug                        String                     @unique
  created_at                  DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                  @default(now()) @db.Timestamp(6)
  property_name               String?
  status                      String?
  asset_type                  String?
  product_type                String?
  region                      Json?
  market                      String?
  submarket                   String?
  property_address            String?
  property_location           Json?
  asking_price                Float?                     @db.Real
  price_per_unit              Float?                     @db.Real
  cap_rate                    Float?                     @db.Real
  gpr                         Float?                     @db.Real
  other_income                Float?                     @db.Real
  total_ltl                   Float?                     @db.Real
  occupancy                   Float?                     @db.Real
  current_occupancy           Float?                     @db.Real
  current_opex_ratio          Float?                     @db.Real
  avg_in_place                Float?                     @db.Real
  avg_market                  Float?                     @db.Real
  target_equity               Float?                     @db.Real
  units                       Float?                     @db.Real
  nrsf                        Float?                     @db.Real
  nra_sf                      Float?                     @db.Real
  year_built                  Float?                     @db.Real
  tags                        Json?
  posture                     Json?
  median_household_income     Float?                     @db.Real
  loan_amount                 Float?                     @db.Real
  loan_balance                Float?                     @db.Real
  interest_rate               Float?                     @db.Real
  amortization_years          Float?                     @db.Real
  io_months                   Float?                     @db.Real
  maturity_date               DateTime?                  @db.Date
  prepay_penalty              String?
  is_assumable                Boolean?
  hero_image                  String?
  hero_title                  String?
  hero_subtitle               String?
  summary                     String?
  teaser_summary              String?
  section_executive_overview  String?
  section_strategic_rationale String?
  section_investment_snapshot String?
  section_property_overview   String?
  section_financials          String?
  section_market_analysis     String?
  section_pro_forma           String?
  section_risk_timeline       String?
  section_recommendation      String?
  section_capex_strategy      String?
  section_sales_comps         String?
  section_opex_analysis       String?
  stat_1_label                String?
  stat_1_value                String?
  stat_2_label                String?
  stat_2_value                String?
  stat_3_label                String?
  stat_3_value                String?
  stat_4_label                String?
  stat_4_value                String?
  highlight_1_icon            String?
  highlight_1_title           String?
  highlight_1_text            String?
  highlight_2_icon            String?
  highlight_2_title           String?
  highlight_2_text            String?
  highlight_3_icon            String?
  highlight_3_title           String?
  highlight_3_text            String?
  specifications              Json?
  investment_returns          Json?
  value_add_plan              Json?
  unit_mix_json               Json?
  access_routes               Json?
  employment_centers          Json?
  recommendation_title        String?
  recommendation_score        String?
  recommendation_reasons      Json?
  footer_contact_name         String?
  footer_contact_email        String?
  footer_contact_company      String?
  footer_disclaimer           String?
  website                     String?
  data_room_url               String?
  om_pdf_url                  String?
  rent_roll                   String?
  t12                         String?
  gallery_urls                String?
  nda_level                   String?
  ic_status                   String?
  ic_date                     DateTime?                  @db.Date
  approved_at                 DateTime?                  @db.Date
  rr_as_of                    String?
  is_featured                 Boolean?                   @default(false)
  hero_stats                  Json?
  highlights_json             Json?
  value_add_plan_json         Json?
  notion_page_id              String?
  noi                         Decimal?                   @db.Decimal
  egi                         Decimal?                   @db.Decimal
  opex                        Decimal?                   @db.Decimal
  debt_service                Decimal?                   @db.Decimal
  dscr                        Decimal?                   @db.Decimal
  t12_taxes                   Decimal?                   @db.Decimal
  t12_insurance               Decimal?                   @db.Decimal
  t12_ti_total                Decimal?                   @db.Decimal
  t12_ti_pct_egi              Decimal?                   @db.Decimal
  tax_reset_pct               Decimal?                   @db.Decimal
  tax_reset_amount            Decimal?                   @db.Decimal
  insurance_adjusted          Decimal?                   @db.Decimal
  ti_adjusted_noi             Decimal?                   @db.Decimal
  ti_adjusted_cap             Decimal?                   @db.Decimal
  ti_adjusted_irr             Decimal?                   @db.Decimal
  ti_adjusted_em              Decimal?                   @db.Decimal
  ti_adjusted_dscr            Decimal?                   @db.Decimal
  recommendation_score_num    Decimal?                   @db.Decimal
  om_assumptions              om_assumptions[]
  om_employment_anchors       om_employment_anchors[]
  om_gallery_images           om_gallery_images[]
  om_investment_highlights    om_investment_highlights[]
  om_observations             om_observations[]
  om_opex_analysis            om_opex_analysis[]
  om_points_of_interest       om_points_of_interest[]
  om_pricing_guidance         om_pricing_guidance[]
  om_pro_forma                om_pro_forma[]
