{
  "name": "monthaven",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "//--- ORCHESTRATION ---": "",
    "setup": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "db:sync": "node scripts/db-sync.cjs",

    "//--- ENGINE (Backend) ---": "",
    "engine:ingest": "cd backend && npx ts-node src/scripts/ingest.ts",
    "engine:blast": "cd backend && npx ts-node src/scripts/blast.ts",
    "engine:test": "cd backend && npm test",

    "//--- STOREFRONT (Frontend) ---": "",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",

    "//--- GOOGLE SERVICES ---": "",
    "clasp:push": "clasp push",
    "clasp:deploy": "clasp push && clasp deploy --description 'auto'"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.14",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2"
  }
}
