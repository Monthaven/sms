generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                String    @id @default(uuid())
  campaignId        String
  contactId         String    @unique // CRITICAL: Marks this as the joining key
  propertyId        String?
  status            String    // Mapped to String to handle custom DB enums safely
  sentimentScore    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  assignedToId      String?
  isFlagged         Boolean   @default(false)
  notes             String?
  lastInteractionAt DateTime? // Added via your SQL command

  // RELATION: One Lead has many Interactions, linked by contactId
  interactions      Interaction[]
}

model Interaction {
  id         String   @id @default(uuid())
  contactId  String   // Foreign key matching Lead.contactId
  channel    String
  direction  String
  body       String
  externalId String?
  createdAt  DateTime @default(now())
  read       Boolean  @default(false) // Added via your SQL command

  // RELATION: Belongs to one Lead
  lead       Lead     @relation(fields: [contactId], references: [contactId])
}
